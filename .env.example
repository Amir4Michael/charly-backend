# بيئة التشغيل
NODE_ENV=development
PORT=5000

# قاعدة البيانات
MONGO_URI=mongodb://localhost:27017/ccf-factory

# JWT — Access token قصير العمر يُرسَل في Authorization header
JWT_ACCESS_SECRET=change-this-access-secret
JWT_ACCESS_EXPIRES=15m

# JWT — Refresh token طويل العمر يُخزَّن في httpOnly Cookie
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_REFRESH_EXPIRES=7d

# رابط الفرونت المسموح له بالاتصال (CORS + الكوكيز)
CLIENT_URL=http://localhost:3000

# سرّ توقيع الكوكيز
COOKIE_SECRET=change-this-cookie-secret

# Rate limiting العام
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Rate limiting خاص بتسجيل الدخول (أشد صرامة لمنع Brute-force)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# كلمة المرور الافتراضية للمستخدمين المزروعين عبر seed:users (غيّرها فورًا بعد أول تشغيل حقيقي)
SEED_DEFAULT_PASSWORD=123456789
